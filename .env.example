# Controller example ONLY. Copy to /home/cqlm/door/.env on a NEW deployment.
# Do not replace the working Pi's existing .env.
MERAKI_API_KEY=REPLACE_WITH_YOUR_MERAKI_API_KEY
MERAKI_SERIAL=REPLACE_WITH_YOUR_CAMERA_SERIAL
AWS_REGION=ap-southeast-2
MQTT_HOST=dash-rpi.local
MQTT_PORT=1883
MQTT_USER=doorpi
MQTT_PASS=REPLACE_WITH_YOUR_BROKER_PASSWORD
# AWS credentials use the normal Boto3 credential chain, not these placeholders.
# Configure your own ~/.aws/credentials or another supported AWS credential source.
