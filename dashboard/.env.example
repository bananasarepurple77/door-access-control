# MQTT listener example ONLY. Keep this separate from the controller .env.
# On a NEW monitoring Pi: copy to /home/cqlm2/dashboard/.env and edit locally.
# Do not overwrite an existing deployment's .env.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=dashpi
MQTT_PASS=REPLACE_WITH_YOUR_BROKER_PASSWORD
# Dashboard and webhook logins/endpoints are configured by their interactive init commands,
# not this file. Never publish their generated .json settings files.
